{
  "$schema": "./schema.json",
  "schema": 1,
  "description": "Arduino board packages with friendly names, extra index URLs and recommendation rules. Every other package in Arduino's index still shows up in search; these entries add to it.",
  "packages": [
    {
      "id": "arduino:avr",
      "kind": "arduino-core",
      "platform": "arduino:avr",
      "name": "Arduino AVR boards",
      "boards": ["Uno", "Nano", "Mega 2560", "Leonardo", "Micro"],
      "recommendWhen": [
        {
          "usb": ["2341:0043", "2341:0001", "2341:0042", "2341:8036", "2341:0036", "2341:8037", "2341:0037"],
          "reason": "${device} plugged in"
        },
        { "fqbn": ["arduino:avr:*"], "reason": "${sketch} builds for ${board}" }
      ]
    },
    {
      "id": "arduino:renesas_uno",
      "kind": "arduino-core",
      "platform": "arduino:renesas_uno",
      "name": "Arduino UNO R4 boards",
      "boards": ["UNO R4 Minima", "UNO R4 WiFi"],
      "recommendWhen": [{ "fqbn": ["arduino:renesas_uno:*"], "reason": "${sketch} builds for ${board}" }]
    },
    {
      "id": "esp32:esp32",
      "kind": "arduino-core",
      "platform": "esp32:esp32",
      "name": "ESP32 boards",
      "description": "Espressif's Arduino core.",
      "boards": ["ESP32", "ESP32-S2", "ESP32-S3", "ESP32-C3", "ESP32-C6"],
      "boardIndex": "https://espressif.github.io/arduino-esp32/package_esp32_index.json",
      "homepage": "https://github.com/espressif/arduino-esp32",
      "recommendWhen": [
        { "usb": ["303a:*"], "reason": "${device} plugged in" },
        { "fqbn": ["esp32:esp32:*"], "reason": "${sketch} builds for ${board}" }
      ]
    },
    {
      "id": "rp2040:rp2040",
      "kind": "arduino-core",
      "platform": "rp2040:rp2040",
      "name": "Raspberry Pi Pico boards",
      "description": "Earle Philhower's Arduino core for RP2040 and RP2350.",
      "boards": ["Pico", "Pico W", "Pico 2", "Pico 2 W"],
      "boardIndex": "https://github.com/earlephilhower/arduino-pico/releases/download/global/package_rp2040_index.json",
      "homepage": "https://github.com/earlephilhower/arduino-pico",
      "recommendWhen": [
        { "usb": ["2e8a:000a", "2e8a:0003"], "reason": "${device} plugged in" },
        { "fqbn": ["rp2040:rp2040:*"], "reason": "${sketch} builds for ${board}" }
      ]
    }
  ]
}
