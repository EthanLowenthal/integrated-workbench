{
  "name": "integrated-workbench",
  "displayName": "Integrated Workbench",
  "description": "Build, upload, and monitor microcontroller projects. Detects connected boards, manages board packages and libraries, and includes a Serial Monitor with a plotter. Supports Arduino sketches (AVR, ESP32, STM32, Raspberry Pi Pico) and MicroPython.",
  "version": "0.5.0",
  "publisher": "integrated-workbench",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "arduino",
    "esp32",
    "stm32",
    "raspberry pi pico",
    "serial monitor",
    "embedded",
    "microcontroller",
    "ch340",
    "board manager",
    "arduino-cli",
    "micropython",
    "rp2040",
    "esptool",
    "uf2"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.ino",
    "onLanguage:cpp",
    "onLanguage:c",
    "workspaceContains:**/boot.py"
  ],
  "contributes": {
    "commands": [
      {
        "command": "integratedWorkbench.newSketch",
        "title": "New Sketch...",
        "category": "Integrated Workbench",
        "icon": "$(new-file)"
      },
      {
        "command": "integratedWorkbench.build",
        "title": "Verify",
        "category": "Integrated Workbench",
        "icon": "$(check)"
      },
      {
        "command": "integratedWorkbench.upload",
        "title": "Upload",
        "category": "Integrated Workbench",
        "icon": "$(arrow-right)"
      },
      {
        "command": "integratedWorkbench.selectBoard",
        "title": "Select Board...",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.selectPort",
        "title": "Select Port...",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.boardDoctor",
        "title": "Show Diagnostics",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.reloadRegistries",
        "title": "Reload Registries",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.showSketch",
        "title": "Show Sketch",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.showTools",
        "title": "Show Boards and Tools",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.openMonitor",
        "title": "Open Serial Monitor",
        "category": "Integrated Workbench",
        "icon": "$(terminal)"
      },
      {
        "command": "integratedWorkbench.writeCompileCommands",
        "title": "Write compile_commands.json for clangd",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.installCppExtension",
        "title": "Install C/C++ Extension for IntelliSense",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.openSketchSettings",
        "title": "Open Sketch Settings",
        "category": "Integrated Workbench",
        "icon": "$(settings-gear)"
      },
      {
        "command": "integratedWorkbench.getStarted",
        "title": "Get Started",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.showLibraries",
        "title": "Show Libraries",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.detectBoard",
        "title": "Detect Board...",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.showOutput",
        "title": "Show Build Output",
        "category": "Integrated Workbench",
        "icon": "$(output)"
      },
      {
        "command": "integratedWorkbench.uploadAndMonitor",
        "title": "Upload and Open Serial Monitor",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.useAsMicroPython",
        "title": "Use Folder as MicroPython Project",
        "category": "Integrated Workbench"
      },
      {
        "command": "integratedWorkbench.stop",
        "title": "Stop",
        "category": "Integrated Workbench",
        "icon": "$(debug-stop)"
      },
      {
        "command": "integratedWorkbench.run",
        "title": "Run on Board",
        "category": "Integrated Workbench",
        "icon": "$(play)"
      },
      {
        "command": "integratedWorkbench.installMicroPython",
        "title": "Install MicroPython on Board...",
        "category": "Integrated Workbench"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "integratedWorkbench.build",
          "when": "integratedWorkbench.inProject",
          "group": "navigation@1"
        },
        {
          "command": "integratedWorkbench.upload",
          "when": "integratedWorkbench.inProject",
          "group": "navigation@2"
        },
        {
          "command": "integratedWorkbench.openMonitor",
          "when": "integratedWorkbench.inProject",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "integratedWorkbench.build",
          "when": "integratedWorkbench.inProject && integratedWorkbench.projectKind != micropython"
        },
        {
          "command": "integratedWorkbench.upload",
          "when": "integratedWorkbench.inProject"
        },
        {
          "command": "integratedWorkbench.stop",
          "when": "integratedWorkbench.inProject"
        },
        {
          "command": "integratedWorkbench.run",
          "when": "integratedWorkbench.projectKind == micropython"
        }
      ],
      "view/title": [
        {
          "command": "integratedWorkbench.showOutput",
          "when": "view == integratedWorkbench.sketch",
          "group": "navigation@1"
        },
        {
          "command": "integratedWorkbench.reloadRegistries",
          "when": "view == integratedWorkbench.tools",
          "group": "overflow"
        },
        {
          "command": "integratedWorkbench.openSketchSettings",
          "when": "view == integratedWorkbench.sketch",
          "group": "overflow"
        },
        {
          "command": "integratedWorkbench.newSketch",
          "when": "view == integratedWorkbench.sketch",
          "group": "navigation"
        },
        {
          "command": "integratedWorkbench.uploadAndMonitor",
          "when": "view == integratedWorkbench.sketch",
          "group": "overflow"
        },
        {
          "command": "integratedWorkbench.installMicroPython",
          "when": "view == integratedWorkbench.sketch && integratedWorkbench.projectKind == micropython",
          "group": "overflow"
        }
      ],
      "explorer/context": [
        {
          "command": "integratedWorkbench.useAsMicroPython",
          "when": "explorerResourceIsFolder",
          "group": "z_integratedWorkbench"
        }
      ]
    },
    "keybindings": [
      {
        "command": "integratedWorkbench.build",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "integratedWorkbench.inProject"
      },
      {
        "command": "integratedWorkbench.upload",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "integratedWorkbench.inProject"
      },
      {
        "command": "integratedWorkbench.openMonitor",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "integratedWorkbench.inProject"
      },
      {
        "command": "integratedWorkbench.uploadAndMonitor",
        "key": "ctrl+alt+shift+u",
        "mac": "cmd+alt+shift+u",
        "when": "integratedWorkbench.inProject"
      }
    ],
    "configuration": {
      "title": "Integrated Workbench",
      "properties": {
        "integratedWorkbench.arduinoCliPath": {
          "type": "string",
          "default": "",
          "description": "Path to an arduino-cli executable. When empty, Integrated Workbench uses the copy it manages, or an arduino-cli found on PATH.",
          "scope": "machine"
        },
        "integratedWorkbench.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "description": "How often, in milliseconds, to check for connected and disconnected boards while a sketch is open and the window is focused."
        },
        "integratedWorkbench.registries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra registries of boards, tools and recipes, added after the built-in one. Each entry is a GitHub repo (`owner/repo` or `owner/repo@branch`, read from its `workbench-registry/index.json`), an `https://` URL to an `index.json`, or an absolute path to a local registry folder. See [Building a registry](https://github.com/EthanLowenthal/integrated-workbench/blob/main/docs/REGISTRY.md).",
          "scope": "machine"
        },
        "integratedWorkbench.boards": {
          "type": "object",
          "scope": "resource",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Board for each sketch, set from the Sketch view: the sketch folder (relative to the workspace folder) mapped to the board ID with any board options, for example `\"Blink\": \"arduino:avr:uno\"` or `\"Lights\": \"esp32:esp32:esp32s3:FlashSize=8M\"`. When a sketch has no entry, its sketch.yaml (from Arduino IDE 2) is used if present; sketch.yaml is never changed."
        },
        "integratedWorkbench.micropython.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Folders treated as MicroPython projects, relative to the workspace folder (`.` for the folder itself). A folder with a `boot.py` is one without being listed. Added by **Use Folder as MicroPython Project**."
        }
      }
    },
    "languages": [
      {
        "id": "cpp",
        "extensions": [
          ".ino",
          ".pde"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "workbench-registry/*.json",
          "workbench-registry/**/*.json",
          "!**/workbench-registry/schema.json"
        ],
        "url": "./workbench-registry/schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "integratedWorkbench",
          "title": "Integrated Workbench",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "integratedWorkbenchMonitor",
          "title": "Serial Monitor",
          "icon": "media/icon.svg"
        },
        {
          "id": "integratedWorkbenchBuild",
          "title": "Build",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "integratedWorkbench": [
        {
          "type": "webview",
          "id": "integratedWorkbench.sketch",
          "name": "Sketch"
        },
        {
          "type": "webview",
          "id": "integratedWorkbench.tools",
          "name": "Boards and Tools",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "integratedWorkbench.libraries",
          "name": "Libraries",
          "visibility": "collapsed",
          "when": "integratedWorkbench.projectKind != micropython"
        }
      ],
      "integratedWorkbenchMonitor": [
        {
          "type": "webview",
          "id": "integratedWorkbench.monitor",
          "name": "Serial Monitor"
        }
      ],
      "integratedWorkbenchBuild": [
        {
          "type": "webview",
          "id": "integratedWorkbench.build",
          "name": "Build"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get Started with Integrated Workbench",
        "description": "Set up a board, upload your first sketch, and read its output.",
        "steps": [
          {
            "id": "sketch",
            "title": "Create or open a sketch",
            "description": "Start from a new sketch, or open a file in an existing one.\n[New Sketch](command:integratedWorkbench.newSketch)",
            "media": {
              "markdown": "media/walkthrough/sketch.md"
            },
            "completionEvents": [
              "onContext:integratedWorkbench.inProject",
              "onCommand:integratedWorkbench.newSketch"
            ]
          },
          {
            "id": "engine",
            "title": "Install the build engine",
            "description": "A one-time download of arduino-cli, Arduino's official build tool.\n[Open Boards and Tools](command:integratedWorkbench.showTools?%5B%22engine%22%5D)",
            "media": {
              "markdown": "media/walkthrough/engine.md"
            },
            "completionEvents": [
              "onContext:integratedWorkbench.engineReady"
            ]
          },
          {
            "id": "board",
            "title": "Select your board",
            "description": "Choose the board the sketch is for. Connected boards that identify themselves are selected automatically.\n[Select Board](command:integratedWorkbench.selectBoard)",
            "media": {
              "markdown": "media/walkthrough/board.md"
            },
            "completionEvents": [
              "onContext:integratedWorkbench.boardSelected"
            ]
          },
          {
            "id": "connect",
            "title": "Connect your board",
            "description": "Plug the board in with a USB data cable and select its port. If it does not appear, Detect Board watches USB while you plug it in and explains what it sees.\n[Detect Board](command:integratedWorkbench.detectBoard)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onContext:integratedWorkbench.portSelected"
            ]
          },
          {
            "id": "upload",
            "title": "Verify and upload",
            "description": "Compile the sketch and write it to the board.\n[Upload](command:integratedWorkbench.upload)",
            "media": {
              "markdown": "media/walkthrough/upload.md"
            },
            "completionEvents": [
              "onCommand:integratedWorkbench.upload"
            ]
          },
          {
            "id": "monitor",
            "title": "Open the Serial Monitor",
            "description": "See what the board prints, send it text, and plot values.\n[Open Serial Monitor](command:integratedWorkbench.openMonitor)",
            "media": {
              "markdown": "media/walkthrough/monitor.md"
            },
            "completionEvents": [
              "onCommand:integratedWorkbench.openMonitor"
            ]
          },
          {
            "id": "more",
            "title": "Board options, IntelliSense, and more",
            "description": "Configure board options and IntelliSense, and add registries.\n[Open Sketch Settings](command:integratedWorkbench.openSketchSettings)",
            "media": {
              "markdown": "media/walkthrough/more.md"
            },
            "completionEvents": [
              "onCommand:integratedWorkbench.openSketchSettings"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "registry:check": "esbuild scripts/registry-check.ts --bundle --platform=node --format=esm --outfile=dist/registry-check.mjs --log-level=warning && node dist/registry-check.mjs",
    "test:e2e": "node esbuild.mjs && node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EthanLowenthal/integrated-workbench.git"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "vscode-cpptools": "^7.1.1"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1B5E7A",
    "theme": "dark"
  },
  "homepage": "https://github.com/EthanLowenthal/integrated-workbench#readme",
  "bugs": {
    "url": "https://github.com/EthanLowenthal/integrated-workbench/issues"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Compiling and uploading can run code from the workspace (for example compiler options in a sketch), so Integrated Workbench runs only in trusted workspaces."
    },
    "virtualWorkspaces": false
  }
}
